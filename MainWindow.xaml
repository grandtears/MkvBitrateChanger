<Window x:Class="MkvBitrateChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MKV Bitrate Changer" Height="760" Width="760" ResizeMode="NoResize"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">
    <Grid Margin="16" AllowDrop="True">
        <StackPanel>
            <TextBlock Text="入力MKV（上から順に変換）" FontWeight="Bold"/>
            <ListBox x:Name="InputFilesListBox" Height="118" Margin="0,4,0,6"
                     SelectionMode="Extended"
                     ToolTip="MKVファイルをここへドラッグ＆ドロップできます"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button x:Name="SelectInputButton" Content="ファイルを追加" Width="110" Margin="0,0,8,0" Click="SelectInput_Click"/>
                <Button x:Name="RemoveInputButton" Content="選択項目を削除" Width="110" Margin="0,0,8,0" Click="RemoveInput_Click"/>
                <Button x:Name="ClearInputButton" Content="すべて削除" Width="90" Click="ClearInput_Click"/>
            </StackPanel>

            <TextBlock Text="出力フォルダー" FontWeight="Bold"/>
            <DockPanel Margin="0,4,0,12">
                <TextBox x:Name="OutputDirectoryTextBox" Height="28" Margin="0,0,8,0"/>
                <Button x:Name="SelectOutputButton" Content="選択" Width="80" Click="SelectOutput_Click"/>
            </DockPanel>

            <GroupBox Header="変換モード" Margin="0,0,0,12">
                <StackPanel Margin="8">
                    <RadioButton x:Name="CrfRadio" Content="可変ビットレート / CRF方式" IsChecked="True"/>
                    <StackPanel Orientation="Horizontal" Margin="24,6,0,8">
                        <TextBlock Text="CRF:" VerticalAlignment="Center"/>
                        <TextBox x:Name="CrfTextBox" Text="23" Width="60" Margin="8,0,16,0"/>
                        <TextBlock Text="Preset:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PresetComboBox" Width="120" Margin="8,0,0,0">
                            <ComboBoxItem Content="fast"/>
                            <ComboBoxItem Content="medium" IsSelected="True"/>
                            <ComboBoxItem Content="slow"/>
                            <ComboBoxItem Content="veryslow"/>
                        </ComboBox>
                    </StackPanel>
                    <RadioButton x:Name="BitrateRadio" Content="固定ビットレート方式"/>
                    <StackPanel Orientation="Horizontal" Margin="24,6,0,0">
                        <TextBlock Text="映像ビットレート:" VerticalAlignment="Center"/>
                        <TextBox x:Name="BitrateTextBox" Text="2000" Width="80" Margin="8,0,4,0"/>
                        <TextBlock Text="kbps" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <CheckBox x:Name="UseH265CheckBox" Content="H.265 / HEVCで圧縮する" Margin="0,0,0,8"/>
            <CheckBox x:Name="LowLoadCheckBox" Content="低負荷モード（変換速度を落として他のアプリを優先）" Margin="0,0,0,12"/>
            <Button x:Name="StartButton" Content="順次変換を開始" Height="36" Click="Start_Click"/>
            <ProgressBar x:Name="ProgressBar" Height="20" Margin="0,12,0,8" Minimum="0" Maximum="100" IsIndeterminate="False"/>
            <TextBlock x:Name="StatusTextBlock" Text="待機中" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <TextBlock Text="変換前: " VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="InputSizeTextBlock" Text="-" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock Text="動画長: " VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="DurationTextBlock" Text="-" VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock Text="変換後: " VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="OutputSizeTextBlock" Text="-" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>

            <TextBox x:Name="LogTextBox" Height="120" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</Window>
